<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.usiu.library.controllers.StudentDashboardController"
            prefWidth="700" prefHeight="500"
            style="-fx-background-color: #f8f9fa;">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15; -fx-background-color: #3f51b5;">
            <Label fx:id="welcomeLabel"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: white; -fx-text-fill: #f03b3bff; -fx-font-weight: bold; -fx-background-radius: 8;" />
            <Button text="My Fines" onAction="#handleShowFines"
                    style="-fx-background-color: white; -fx-text-fill: #04769dff; -fx-font-weight: bold; -fx-background-radius: 8;" />
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <TabPane fx:id="studentTabs" prefWidth="650" prefHeight="400">

            <!-- TAB 1: Available Books -->
            <Tab text="Available Books">
                <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER">
                        <TextField fx:id="searchField" promptText="Search by title..." prefWidth="300" />
                        <Button text="Search" onAction="#handleSearch"
                                style="-fx-background-color: #4caf50; -fx-text-fill: white;" />
                    </HBox>

                    <TableView fx:id="availableBooksTable" prefWidth="600" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="bookIdColumn" text="Book ID" prefWidth="100" />
                            <TableColumn fx:id="titleColumn" text="Title" prefWidth="200" />
                            <TableColumn fx:id="authorColumn" text="Author" prefWidth="150" />
                            <TableColumn fx:id="statusColumn" text="Availability" prefWidth="100" />
                        </columns>
                    </TableView>

                    <Button text="Borrow Selected Book" onAction="#handleBorrowBook"
                            style="-fx-background-color: #17cee2ff; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="200" />
                </VBox>
            </Tab>

            <!-- TAB 2: My Borrowed Books -->
            <Tab text="My Borrowed Books">
                <VBox spacing="15" alignment="CENTER" style="-fx-padding: 15;">
                    <TableView fx:id="borrowedBooksTable" prefWidth="600" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="borrowedBookIdColumn" text="Book ID" prefWidth="100" />
                            <TableColumn fx:id="borrowedTitleColumn" text="Title" prefWidth="200" />
                            <TableColumn fx:id="borrowedAuthorColumn" text="Author" prefWidth="150" />
                            <TableColumn fx:id="returnDateColumn" text="Return Date" prefWidth="150" />
                        </columns>
                    </TableView>

                    <Button text="Return Selected Book" onAction="#handleReturnBook"
                            style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="200" />
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 10;">
            <Label text="© 2025 USIU Library Management System" style="-fx-font-size: 11px; -fx-text-fill: gray;" />
        </HBox>
    </bottom>

</BorderPane>
