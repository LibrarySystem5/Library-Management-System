<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.usiu.library.controllers.FinesController"
            prefWidth="600" prefHeight="400">

    <VBox spacing="15" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" 
          AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">
        
        <!-- Student Information Section -->
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="10"/></padding>
            
            <Label text="Student Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="studentNameField" editable="false" 
                     GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            
            <Label text="Book Title:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="bookTitleField" editable="false"
                     GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            
            <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="dueDateField" editable="false"
                     GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            
            <Label text="Fine Rate (per day):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="fineRateField" editable="false"
                     GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            
            <Label text="Days Overdue:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="daysOverdueField"
                     GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>
        
        <!-- Separator -->
        <Separator/>
        
        <!-- Payment Section -->
        <VBox spacing="10">
            <!-- Total and Payment Buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Total Fine: KES"/>
                <Label fx:id="totalFineLabel" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <Button fx:id="calculateButton" text="Calculate Total" 
                        onAction="#handleCalculateTotal"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button fx:id="payFineButton" text="Pay Fine" 
                        onAction="#handlePayFine"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
            </HBox>

            <!-- Back Button -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Back to Dashboard" onAction="#handleBack"
                        style="-fx-background-color: #757575; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
        
    </VBox>
</AnchorPane>
