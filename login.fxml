<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.usiu.library.LoginController"
            prefWidth="420" prefHeight="420"
            style="-fx-background-color: #f7f7f7;">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
            <Label text="USIU Library System"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />

            <TabPane fx:id="authTabPane" prefWidth="350">

                <!-- LOGIN TAB -->
                <Tab text="Login">
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                        <TextField fx:id="loginUsernameField" promptText="Username" prefWidth="250" />
                        <PasswordField fx:id="loginPasswordField" promptText="Password" prefWidth="250" />

                        <ComboBox fx:id="loginRoleCombo" prefWidth="250" promptText="Select Role">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Student" />
                                    <String fx:value="Librarian" />
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Button text="Login" onAction="#handleLogin"
                                prefWidth="250"
                                style="-fx-background-color: #22aecdff; -fx-text-fill: white; -fx-font-weight: bold;" />

                        <Label fx:id="loginErrorLabel" textFill="red" visible="false" wrapText="true" />
                    </VBox>
                </Tab>

                <!-- SIGNUP TAB -->
                <Tab text="Sign Up">
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                        <TextField fx:id="signupNameField" promptText="Full Name" prefWidth="250" />
                        <TextField fx:id="signupUsernameField" promptText="Username" prefWidth="250" />
                        <PasswordField fx:id="signupPasswordField" promptText="Password" prefWidth="250" />
                        <PasswordField fx:id="signupConfirmField" promptText="Confirm Password" prefWidth="250" />

                        <ComboBox fx:id="signupRoleCombo" prefWidth="250" promptText="Select Role">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Student" />
                                    <String fx:value="Librarian" />
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Button text="Create Account" onAction="#handleSignup"
                                prefWidth="250"
                                style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold;" />

                        <Label fx:id="signupMessageLabel" textFill="green" visible="false" wrapText="true" />
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 10;">
            <Label text="© 2025 USIU Library Management System" style="-fx-font-size: 11px; -fx-text-fill: gray;" />
        </HBox>
    </bottom>

</BorderPane>
