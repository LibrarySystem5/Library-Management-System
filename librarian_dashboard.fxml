<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.usiu.library.controllers.LibrarianDashboardController"
            prefWidth="800" prefHeight="500"
            style="-fx-background-color: #f5f5f5;">

    <!-- TOP BAR -->
    <top>
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #3f51b5; -fx-padding: 10;">
            <Label text="📚 Welcome Librarian!" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <!-- CENTER SECTION -->
    <center>
    <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Book Inventory" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />

            <TableView fx:id="bookTable" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colBookId" text="Book ID" prefWidth="100" />
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="200" />
                    <TableColumn fx:id="colAuthor" text="Author" prefWidth="150" />
                    <TableColumn fx:id="colStatus" text="Available" prefWidth="100" />
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Add Book" onAction="#handleAddBook" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                <Button text="Update Book" onAction="#handleUpdateBook" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
                <Button text="Remove Book" onAction="#handleRemoveBook" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </center>

    <!-- BOTTOM FOOTER -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 10;">
            <Label text="© 2025 USIU Library System" style="-fx-font-size: 11px; -fx-text-fill: gray;" />
        </HBox>
    </bottom>
</BorderPane>
