<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.usiu.library.controllers.AddBookController"
      alignment="CENTER" spacing="12"
      style="-fx-padding: 20; -fx-background-color: #fdfdfd;">

    <Label text="➕ Add New Book"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" />

    <TextField fx:id="titleField" promptText="Book Title" prefWidth="250" />
    <TextField fx:id="authorField" promptText="Author" prefWidth="250" />
    <TextField fx:id="yearField" promptText="Publication Year" prefWidth="250" />

    <CheckBox fx:id="availableCheck" text="Available" selected="true" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="Save"
                onAction="#handleSaveBook"
                style="-fx-background-color: #157adfff; -fx-text-fill: white; -fx-font-weight: bold;" />
        <Button text="Cancel"
                onAction="#handleCancel"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

    <Label fx:id="messageLabel" textFill="green" visible="false" wrapText="true" />
</VBox>
